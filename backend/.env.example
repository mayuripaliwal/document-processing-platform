DATABASE_URL = postgresql+psycopg://username:password@localhost:5433/db_name

TEST_DATABASE_URL = postgresql+psycopg://username:password@localhost:5433/test_db_name

JWT_SECRET_KEY = your-jwt-secret-key

ENVIRONMENT = development

GROQ_API_KEY = your-groq-api-key
GROQ_MODEL = "openai/gpt-oss-20b"

FRONTEND_URL = http://localhost:5173

DAILY_USER_USAGE_QUOTA_SEARCH_API = 10

SUPABASE_ACCESS_KEY_ID = your-supabase-access-key-id
SUPABASE_SECRET_ACCESS_KEY = your-supabase-secret-access-key
SUPABASE_S3_ENDPOINT = your-supabase-s3-endpoint
SUPABASE_S3_REGION = your-supabase-s3-region